{
  "version": 9,
  "cmakeMinimumRequired": {"major": 3, "minor": 28, "patch": 0},
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -Wall -Wextra -Wpedantic",
        "BUILD_TESTS": "ON",
        "USE_TUI": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "BUILD_TESTS": "OFF",
        "USE_TUI": "ON"
      }
    },
    {
      "name": "cli-only",
      "displayName": "CLI Only (no TUI)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cli",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON",
        "USE_TUI": "OFF"
      }
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "release", "configurePreset": "release"},
    {"name": "cli-only", "configurePreset": "cli-only"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"verbosity": "verbose"}}
  ]
}
